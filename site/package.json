{
  "name": "airband-site",
  "private": true,
  "description": "airband.harshbaldaniya.com: the Airband website, a static Next.js export",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "dev": "npm run sync && next dev -p 3500",
    "build": "npm run sync && next build",
    "start": "npx serve out -l 3500",
    "deploy": "npm run build && npx -y wrangler@4 pages deploy out --project-name airband-site --branch main"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.0.0",
    "lenis": "1.3.27",
    "lucide-react": "^0.500.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}

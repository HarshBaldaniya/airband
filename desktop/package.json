{
  "name": "airband-desktop",
  "productName": "Airband",
  "private": true,
  "version": "0.0.5",
  "description": "Airband's desktop companion: every AI chat on your computer, from a corner of your screen.",
  "author": "Harsh Baldaniya",
  "license": "MIT",
  "homepage": "https://github.com/HarshBaldaniya/airband",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && node scripts/run.mjs",
    "pack": "node build.mjs && electron-builder --dir",
    "dist": "node build.mjs && electron-builder",
    "install-app": "node install-app.mjs"
  },
  "build": {
    "appId": "dev.airband.app",
    "productName": "Airband",
    "copyright": "Copyright © 2026 Harsh Baldaniya",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "airband",
        "filter": [
          "airband-hook.js",
          "airband-mcp.js",
          "airband.js",
          "wasm/**",
          "companion/**"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null,
      "darkModeSupport": true,
      "extendInfo": {
        "LSUIElement": true,
        "NSLocalNetworkUsageDescription": "Airband shows your chats on your phone when you turn on the phone link."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Airband"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "electronLanguages": [
      "en",
      "en-GB"
    ],
    "compression": "maximum"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "qrcode": "^1.5.4"
  }
}

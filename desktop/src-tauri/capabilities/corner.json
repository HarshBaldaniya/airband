{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "corner",
  "description": "Roger's corner: only the Station's own page on this computer may call the app, and only these.",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*/*", "http://127.0.0.1:*"] },
  "permissions": [
    "core:event:allow-listen", "core:event:allow-unlisten",
    "allow-hit-areas", "allow-drag", "allow-prefs", "allow-set-pref", "allow-menu", "allow-hide", "allow-asleep", "allow-come-back", "allow-log-line", "allow-update-info", "allow-install-update"
  ]
}
